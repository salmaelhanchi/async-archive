# Every setting, with its default. Copy to .env and change what you need.
# All variables are read by src/archive_mirror/settings.py and nowhere else.

# State
ARCHIVE_MIRROR_STATE_DB=data/state.sqlite

# Identity: a URL where archive admins can reach you, added to the User-Agent
ARCHIVE_MIRROR_CONTACT_URL=

# Concurrency (protects you) vs rate (protects the server)
ARCHIVE_MIRROR_LISTING_WORKERS=4
ARCHIVE_MIRROR_MAX_IN_FLIGHT=4
ARCHIVE_MIRROR_PER_HOST_RATE=2.0
ARCHIVE_MIRROR_PER_HOST_BURST=2
ARCHIVE_MIRROR_RESPECT_ROBOTS=true
ARCHIVE_MIRROR_HTTP2=true

# Retries
ARCHIVE_MIRROR_REQUEST_TIMEOUT_S=30
ARCHIVE_MIRROR_MAX_ATTEMPTS=5
ARCHIVE_MIRROR_BACKOFF_BASE_S=0.5
ARCHIVE_MIRROR_BACKOFF_CAP_S=30
ARCHIVE_MIRROR_MAX_RETRY_AFTER_S=300

# Budgets and bounds
ARCHIVE_MIRROR_MAX_LISTING_BYTES=20971520
ARCHIVE_MIRROR_MAX_DEPTH=32
ARCHIVE_MIRROR_MAX_LISTING_PAGES=10000
ARCHIVE_MIRROR_WRITE_QUEUE_SIZE=256
# auto | apache | nginx | iis
ARCHIVE_MIRROR_LISTING_FORMAT=auto

# Observability
# Set a port to serve Prometheus metrics on /metrics
ARCHIVE_MIRROR_METRICS_PORT=
# DEBUG | INFO | WARNING | ERROR
ARCHIVE_MIRROR_LOG_LEVEL=INFO
ARCHIVE_MIRROR_LOG_JSON=false
